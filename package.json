{
  "name": "dsh-search-mix",
  "version": "0.1.0",
  "description": "Mix two search APIs for every DeepSeek Harness web search: ask them at once, interleave their pages, and drop duplicates. · 混合搜索：同时问两家搜索 API，按序交错合并结果。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "web-search",
    "search",
    "tavily",
    "brave-search",
    "exa",
    "searxng",
    "you",
    "firecrawl",
    "volcengine",
    "yuanbao"
  ],
  "author": "mdwsk88",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdwsk88/dsh-search-mix.git"
  },
  "homepage": "https://github.com/mdwsk88/dsh-search-mix#readme",
  "bugs": {
    "url": "https://github.com/mdwsk88/dsh-search-mix/issues"
  },
  "scripts": {
    "test": "node --test"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
